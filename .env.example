# node — เครื่องของลูกค้า
#
# ค่าการเชื่อมต่อด้านล่าง (central, license, LLM, embedding, rerank, Qdrant) ใช้เป็น "ค่าเริ่มต้น"
# ตอนเปิดครั้งแรกเท่านั้น หลังจากนั้นแก้ที่หน้าเว็บ: หลังบ้าน → การเชื่อมต่อ AI (/admin/settings)
# ค่าในหน้าเว็บถูกเข้ารหัสเก็บใน data/node.db และมีผลทันทีโดยไม่ต้องรีสตาร์ต
#
# กุญแจเข้ารหัส: ถ้าไม่ตั้ง NODE_SECRET_KEY ระบบสร้าง data/secret.key ให้เอง — สำรองคู่กับ node.db เสมอ
# NODE_SECRET_KEY=

# ที่อยู่ central และ license key ของคุณ
CENTRAL_URL=https://central.1n9ai.com
# ต้องเป็น https:// (ทุกคำขอมี API key และข้อมูลของคุณ) — http ใช้ได้เฉพาะเครื่องเดียวกัน, ชื่อ service ใน docker หรือวง LAN
# (ไม่บังคับ) ยอมรับเฉพาะใบรับรองที่ออกโดย CA ในไฟล์นี้สำหรับ central แทนการเชื่อ CA ทั้งหมด (certificate pinning)
# CENTRAL_CA_FILE=/app/data/central-ca.pem
LICENSE_KEY=

# รหัสผ่านหน้าเว็บ node (Basic Auth) — ว่าง = ไม่ล็อก (อย่าเว้นว่างบนเครื่องจริง)
NODE_USER=admin
NODE_PASSWORD=

# เปิด node ผ่านชื่อโดเมน (เช่นหลัง nginx: node.company.com) ต้องใส่โดเมนนั้นที่นี่ คั่นด้วย , — ไม่งั้นได้ 403
# (localhost และ IP ตรง ๆ ใช้ได้เสมอ) กันเว็บอื่นแอบสั่งงาน node ผ่านเบราว์เซอร์ของคุณ
# NODE_ALLOWED_HOSTS=node.company.com

# LLM: google | openai_compatible | ollama
#   ollama: LLM_BASE_URL=http://<ip>:11434 (ไม่ต้องมี /v1 และไม่ต้องใส่ key), LLM_MODEL ตามชื่อใน `ollama list`
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Embedding: openai_compatible | google | ollama — ล็อกต่อ KB ตอนสร้าง ห้ามเปลี่ยนหลังมี KB แล้ว
# EMBED_DIM ต้องตรงกับมิติจริงของโมเดล (ตรวจได้จากปุ่ม "ตรวจการเชื่อมต่อ")
EMBED_PROVIDER=openai_compatible
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_DIM=2560
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.com/v1

# Rerank (ไม่บังคับ) — endpoint แบบ /rerank
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_BASE_URL=https://api.siliconflow.com/v1

# ที่เก็บเอกสาร (vector database)
#   local    = Qdrant ในเครื่องนี้ (ค่าเริ่มต้น — docker-compose แถมให้แล้ว) central เข้าผ่านท่อที่ node เปิดเอง ไม่ต้องเปิดพอร์ต
#   qdrant   = Qdrant ที่ central ต่อตรงได้ เช่น Qdrant Cloud (ใส่ QDRANT_URL + QDRANT_API_KEY)
#   pgvector / pinecone ตั้งที่หน้าเว็บ (หลังบ้าน → การเชื่อมต่อ AI)
VECTOR_TYPE=local
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
